# Downloaded source data. Everything in here is fetched at run time and can
# be re-fetched; none of it belongs in version control.
raw_files/*
!raw_files/.gitkeep
!raw_files/bop_manual.xlsx

# Pipeline output
Macro_Metrics_*.xlsx
processed_metrics.json
processed_series.json
deck_digest.md

# Decks
*.pptx

# Hand-set identifiers. This one is deliberately ignored: it records what is
# broken on YOUR machine right now, and committing it would silently pin ids
# for everyone else. overrides.example.json is the version-controlled
# template. If your team wants a shared set, commit it under another name and
# copy it into place.
overrides.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Editors and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# LibreOffice lock files, left behind when a recalculation is interrupted
.~lock.*#
